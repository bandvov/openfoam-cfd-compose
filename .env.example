CASE_NAME=aircraft
GEOMETRY=/workspace/geometry/model.stl

# Free-stream conditions
SPEED=30
AIR_DENSITY=1.225
KINEMATIC_VISCOSITY=1.5e-5

# Reference dimensions for aerodynamic coefficients
CHORD=1.0
WING_AREA=1.0

# RANS turbulence intensity (fraction, e.g. 0.01 = 1%)
TURBULENCE_INTENSITY=0.01

MAX_ITER=1000
MESH_SCALE=1.0

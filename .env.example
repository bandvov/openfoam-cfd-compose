CASE_NAME=aircraft

# STL path inside the container. Bundled samples:
#   geometry/model2.stl  millimetres, watertight (2000 x 1000 x 301 mm) -> MODEL_UNITS=mm (default)
#   geometry/model3.stl  metres, watertight (1 x 1 x 0.3 m)             -> MODEL_UNITS=m
GEOMETRY=/workspace/geometry/model2.stl

# Units of the STL file: m, mm, cm, in or ft
MODEL_UNITS=mm
# Optional explicit factor to metres; overrides MODEL_UNITS when set.
# MESH_SCALE=

# Free stream (flow runs along +X)
SPEED=30
# Angle of attack in degrees, positive nose-up. The STL must have its nose at -X
# and "up" as +Z; the geometry is pitched about its centre.
ANGLE_OF_ATTACK=0
AIR_DENSITY=1.225
KINEMATIC_VISCOSITY=1.5e-5

# Reference chord (m) and area (m^2) for Cd/Cl/Cm. "auto" = mean chord and
# top-view planform area computed from the STL. Set numbers to override.
CHORD=auto
WING_AREA=auto

# RANS turbulence intensity (fraction, e.g. 0.01 = 1%)
TURBULENCE_INTENSITY=0.01

MAX_ITER=2000

# Mesh quality: coarse (quick check) | medium (default) | fine (slow, much RAM)
MESH_QUALITY=medium
# Optional overrides of the preset:
# LAYERS=3                  prism layers on the surface (0 = none)
# SURFACE_REFINEMENT_MIN=3
# SURFACE_REFINEMENT_MAX=4
# WAKE_LEVEL=2              refinement of the box around body + wake (0 = off)
# MAX_GLOBAL_CELLS=5000000

# CPU cores for the solver (1 = serial). Set to your physical core count.
NPROCS=1

# Optional: pin a different OpenFOAM base image tag
# OPENFOAM_IMAGE_TAG=2506-oe2403sp2
